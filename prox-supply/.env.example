# PostgreSQL connection string (Neon: use the pooled connection string, with ?sslmode=require)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proxsupply"
# Admin login. Generate the hash with: npm run admin:hash -- "your-password"
ADMIN_PASSWORD_HASH=""
# Long random string used to sign admin sessions (32+ chars). e.g. openssl rand -base64 48
SESSION_SECRET=""
# Default for the "Your Discord" setting (can be changed in Admin → Settings)
NEXT_PUBLIC_SELLER_DISCORD="YourDiscordName"
