# Copy to .env, fill in, then: set -a; source .env; set +a
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourstudio.com
SMTP_PASS=app-password-here
SMTP_FROM=you@yourstudio.com
IMAP_HOST=imap.gmail.com
